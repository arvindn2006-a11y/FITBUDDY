        "\n",
        "\n",
        "query = \"I was charged twice for my order.\"\n",
        "\n",
        "def zero_shot(query):\n",
        "    return \"Please contact customer support to verify the duplicate charge.\"\n",
        "\n",
        "def few_shot(query):\n",
        "    return \"Example: For a payment issue, contact customer support. \" \\\n",
        "           \"Please contact customer support to verify the duplicate charge.\"\n",
        "\n",
        "\n",
        "def step_by_step(query):\n",
        "    return (\"Step 1: Check the transaction details. \"\n",
        "            \"Step 2: Contact customer support for verification.\")\n",
        "\n",
        "\n",
        "def self_consistency(query):\n",
        "    responses = [\n",
        "        \"Contact customer support to verify the duplicate charge.\",\n",
        "        \"Share your transaction details with customer support.\",\n",
        "        \"Ask customer support to check the payment.\"\n",
        "    ]\n",
        "    return responses[0]\n",
        "\n",
        "\n",
        "print(\"Customer Query:\", query)\n",
        "print(\"\\nZero-shot Output:\")\n",
        "print(zero_shot(query))\n",
        "\n",
        "print(\"\\nFew-shot Output:\")\n",
        "print(few_shot(query))\n",
        "\n",
        "print(\"\\nStep-by-step Output:\")\n",
        "print(step_by_step(query))\n",
        "\n",
        "print(\"\\nSelf-consistency Output:\")\n",
        "print(self_consistency(query))\n",
        "\n",
        "print(\"\\nPrompt engineering workflow executed successfully!\")\n"
      ]
